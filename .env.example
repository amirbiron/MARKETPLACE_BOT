# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=marketplace_bot

# Admin Configuration (comma-separated user IDs)
ADMIN_IDS=123456789,987654321

# Admin Forum (Topics) Configuration (optional)
# Put the bot as admin in a "Forum" group (Topics enabled) and set its chat_id here.
# Example: -1001234567890
ADMIN_FORUM_CHAT_ID=0
# If omitted/empty, it's enabled automatically when ADMIN_FORUM_CHAT_ID != 0
ADMIN_FORUM_ENABLED=false

# Environment
ENVIRONMENT=development

# Payment Configuration - הגדרות תשלום ידני
MIN_DEPOSIT_AMOUNT=50
BIT_PHONE=050-1234567
PAYBOX_LINK=https://payboxapp.page.link/your-link
BANK_NAME=לאומי
BANK_BRANCH=123
BANK_ACCOUNT=12345678
BANK_OWNER=שם בעל החשבון

# ==================== Payment Gateway Configuration ====================
# Enable/disable credit card payments
PAYMENT_GATEWAY_ENABLED=false

# Active payment gateway: tranzila, cardcom, payplus, meshulam
PAYMENT_GATEWAY=tranzila

# --- Tranzila Settings ---
TRANZILA_TERMINAL=your_terminal_name
TRANZILA_PASSWORD=your_password
TRANZILA_API_URL=https://secure5.tranzila.com/cgi-bin/tranzila71.cgi

# --- CardCom Settings ---
CARDCOM_TERMINAL=your_terminal_number
CARDCOM_USERNAME=your_username
CARDCOM_API_KEY=your_api_key
CARDCOM_API_URL=https://secure.cardcom.solutions/interface/ChargeToken.aspx

# --- PayPlus Settings ---
PAYPLUS_API_KEY=your_api_key
PAYPLUS_SECRET_KEY=your_secret_key
PAYPLUS_TERMINAL_UID=your_terminal_uid
PAYPLUS_API_URL=https://restapidev.payplus.co.il/api/v1.0

# --- Meshulam Settings ---
MESHULAM_PAGE_CODE=your_page_code
MESHULAM_USER_ID=your_user_id
MESHULAM_API_KEY=your_api_key
MESHULAM_API_URL=https://secure.meshulam.co.il/api

# --- Webhook Settings ---
# Base URL for payment callbacks (your server's public URL)
WEBHOOK_BASE_URL=https://your-domain.com
WEBHOOK_SECRET=your_webhook_secret_for_verification

# --- Payment Security Settings ---
PAYMENT_3D_SECURE_ENABLED=true
DAILY_CARD_LIMIT=5000
MAX_TRANSACTION_AMOUNT=2000
MIN_CARD_PAYMENT=10
PAYMENT_TIMEOUT_MINUTES=30

# --- Saved Cards Settings ---
ALLOW_SAVE_CARD=true
MAX_SAVED_CARDS_PER_USER=5

# ==================== Automated Payout Settings ====================
AUTO_PAYOUT_ENABLED=false
PAYOUT_COMMISSION=0.01
MIN_AUTO_PAYOUT_AMOUNT=200
PAYOUT_PROCESSING_DAYS=3

# --- PayPal Payout Settings (Optional) ---
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# --- Payoneer Payout Settings (Optional) ---
PAYONEER_PROGRAM_ID=your_program_id
PAYONEER_API_KEY=your_api_key
PAYONEER_API_URL=https://api.sandbox.payoneer.com
